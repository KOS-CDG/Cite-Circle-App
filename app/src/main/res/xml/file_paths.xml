<?xml version="1.0" encoding="utf-8"?>
<!--
  The only directory FileProvider will hand out URIs for. ShareUtils writes every
  outgoing citation card, .bib, and .ris file into cacheDir/shared, so nothing else
  in the app's storage is reachable by a receiving app.
-->
<paths>
    <cache-path name="shared" path="shared/" />
    <files-path name="vault_pdfs" path="vault_pdfs/" />
    <cache-path name="updates" path="updates/" />
    <external-files-path name="updates_ext" path="updates/" />
    <external-files-path name="downloads_ext" path="Download/" />
</paths>
